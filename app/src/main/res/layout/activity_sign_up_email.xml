<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SignUpEmailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Icon -->
        <ImageView
            android:id="@+id/signup_logo"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/person_icon"
            app:tint="@color/my_primary"
            android:contentDescription="Sign up icon"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!-- Title -->
        <TextView
            android:id="@+id/signup_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create your account"
            android:textStyle="bold"
            android:textSize="22sp"
            android:letterSpacing="0.02"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Full name -->
        <EditText
            android:id="@+id/et_fullname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="@drawable/edit_text_rounded_corner"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="12dp"
            android:hint="Full name"
            android:inputType="textPersonName"
            android:autofillHints="name"
            android:drawableStart="@drawable/ic_user"
            android:drawablePadding="8dp" />

        <!-- Email -->
        <EditText
            android:id="@+id/et_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="@drawable/edit_text_rounded_corner"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="12dp"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:autofillHints="emailAddress"
            android:drawableStart="@drawable/ic_email"
            android:drawablePadding="8dp" />

        <!-- Password -->
        <EditText
            android:id="@+id/et_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="@drawable/edit_text_rounded_corner"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="12dp"
            android:hint="Password"
            android:inputType="textPassword"
            android:autofillHints="newPassword"
            android:drawableStart="@drawable/ic_lock"
            android:drawablePadding="8dp" />

        <!-- Confirm Password -->
        <EditText
            android:id="@+id/et_confirm_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="@drawable/edit_text_rounded_corner"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="8dp"
            android:hint="Confirm password"
            android:inputType="textPassword"
            android:autofillHints="newPassword"
            android:drawableStart="@drawable/ic_lock"
            android:drawablePadding="8dp" />

        <!-- Terms & policy -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <CheckBox
                android:id="@+id/cb_terms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/my_primary" />

            <TextView
                android:id="@+id/tv_terms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="I agree to the Terms and Privacy Policy"
                android:textSize="14sp"
                android:paddingStart="8dp" />
        </LinearLayout>

        <!-- Sign up button -->
        <Button
            android:id="@+id/btn_sign_up"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Create account"
            android:textAllCaps="false"
            android:background="@drawable/btn_rounded_corner" />

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/signup_progress"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:indeterminateTint="@color/my_primary"
            android:visibility="gone" />

        <!-- Already have an account?  Log in here -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_have_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? "
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_login_here"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log in here"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/my_primary"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Small helper -->
        <TextView
            android:id="@+id/tv_helper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="We’ll send a verification email to activate your account."
            android:textSize="12sp"
            android:textColor="@color/light_gray"
            android:gravity="center" />
    </LinearLayout>
</ScrollView>
